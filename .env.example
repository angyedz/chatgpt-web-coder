# OpenAI Secure MCP Tunnel runtime key (Platform -> Runtime API keys).
# The key needs Tunnels Read + Use on the target tunnel.
CONTROL_PLANE_API_KEY=sk-...

# Optional: SearXNG instance. The JSON API must be enabled.
SEARXNG_URL=http://127.0.0.1:8888

# Optional overrides.
# MCP_PORT=8790
# CHATGPT_MODEL_LABEL=
# CHATGPT_EFFORT_LABEL=
# CHATGPT_CODER_UPDATE_REPOSITORY=angyedz/chatgpt-web-coder
# CHATGPT_CONNECTOR_NAME=chatgpt-coder
# HARNESS_ATTACH_CONNECTOR=true
# HARNESS_APPROVAL=ask
# HARNESS_HEADLESS=false
# CHATGPT_CODER_REDUCED_MOTION=1
